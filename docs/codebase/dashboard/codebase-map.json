{
  "system": {
    "name": "AIインタビュー",
    "purpose": "インタビューを通じて知識を引き出し、人の確認を経て構造化ナレッジとして保存するWebアプリ。",
    "boundary": "app/apiが認可・状態遷移・OpenAI API呼び出し・保存の正本。BrowserはGPT LiveのWebRTC音声接続を担当する。",
    "runtimePath": [
      "Browser",
      "React / Vite",
      "FastAPI API",
      "OpenAI API",
      "PostgreSQL"
    ],
    "status": "ComposeではWeb、API、PostgreSQLを起動。OpenAI Project APIキーはBackendが暗号化して保存する。"
  },
  "components": [
    {
      "id": "web",
      "name": "Web application",
      "layer": "client",
      "role": "画面、i18n、操作ガイド、API・GPT Liveクライアント",
      "owns": "表示・ユーザー操作・画面上の状態",
      "notOwns": "認可保証・インタビュー状態遷移・保存・秘密キー",
      "dependsOn": [
        "api",
        "openai"
      ],
      "code": "app/web/src/app/App.tsx"
    },
    {
      "id": "api",
      "name": "FastAPI API",
      "layer": "backend",
      "role": "REST / SSE、認可、業務処理、OpenAI連携",
      "owns": "API契約・状態遷移・AI処理・保存",
      "notOwns": "画面表示・Browser音声入出力",
      "dependsOn": [
        "services",
        "repositories",
        "openai",
        "postgres"
      ],
      "code": "app/api/src/ai_interviewer_api/main.py"
    },
    {
      "id": "services",
      "name": "Application services",
      "layer": "domain",
      "role": "回答評価、質問設計、承認、分析",
      "owns": "業務状態とBackendの保証",
      "notOwns": "画面上の会話表示",
      "dependsOn": [
        "agents",
        "repositories"
      ],
      "code": "app/api/src/ai_interviewer_api/services/"
    },
    {
      "id": "agents",
      "name": "OpenAI API providers",
      "layer": "ai",
      "role": "Responses APIとStructured Outputs",
      "owns": "モデル出力",
      "notOwns": "認可・正式保存",
      "dependsOn": [
        "openai"
      ],
      "code": "app/api/src/ai_interviewer_api/agents/"
    },
    {
      "id": "repositories",
      "name": "Repository store",
      "layer": "backend",
      "role": "論理エンティティのテナントスコープ保存・取得",
      "owns": "PostgreSQL Store契約",
      "notOwns": "UI表示・認可画面の判断",
      "dependsOn": [
        "postgres"
      ],
      "code": "app/api/src/ai_interviewer_api/repositories/store.py"
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "layer": "storage",
      "role": "JSONB payloadと検索用メタデータの永続化",
      "owns": "耐久性のある保存",
      "notOwns": "業務状態の決定",
      "dependsOn": [],
      "code": "infra/postgres/init/001_schema.sql"
    },
    {
      "id": "openai",
      "name": "OpenAI API",
      "layer": "ai",
      "role": "Responses APIとGPT Live音声対話",
      "owns": "生成・構造化出力・音声対話",
      "notOwns": "アプリ認可・業務状態保存",
      "dependsOn": [],
      "code": "app/api/src/ai_interviewer_api/agents/"
    }
  ],
  "flows": [
    {
      "id": "text-interview",
      "label": "Text interview",
      "kind": "normal",
      "summary": "メッセージを認可・状態遷移・OpenAI Responses API処理を経てPostgreSQLへ保存する。",
      "steps": [
        "Browser入力",
        "FastAPI Router",
        "Service / Agent",
        "OpenAI Responses API",
        "Structured Output検証",
        "PostgreSQL",
        "Response / SSE"
      ],
      "source": "../ARCHITECTURE.md#2-テキストインタビュー"
    },
    {
      "id": "voice-interview",
      "label": "GPT Live interview",
      "kind": "async",
      "summary": "BrowserがGPT LiveへWebRTC接続し、Backendが意味評価と状態保存を担う。",
      "steps": [
        "Browser WebRTC",
        "OpenAI GPT Live",
        "Transcript Capture API",
        "Responses API delegation",
        "Backend validation",
        "PostgreSQL"
      ],
      "source": "../../architecture/voice/realtime-voice.md"
    },
    {
      "id": "persistence",
      "label": "Persistence",
      "kind": "persist",
      "summary": "API起動時にスキーマを確認し、PostgreSQLへ保存する。",
      "steps": [
        "API startup",
        "ensure_schema",
        "PostgresStore",
        "entity_store JSONB"
      ],
      "source": "../ARCHITECTURE.md#4-モジュール責務"
    }
  ],
  "states": [
    {
      "name": "Interview answer",
      "states": [
        "UNANSWERED",
        "CANDIDATE_PENDING",
        "AWAITING_CONFIRMATION",
        "CONFIRMED"
      ],
      "transitions": [
        "回答を評価して候補化",
        "確認応答を評価",
        "Backendが確定を保証"
      ],
      "guards": [
        "認可",
        "state version",
        "人による承認"
      ],
      "cancel": "未確定の候補を正式ナレッジとして保存しない"
    },
    {
      "name": "Record review",
      "states": [
        "in_progress",
        "submitted",
        "returned",
        "approved"
      ],
      "transitions": [
        "完了でsubmitted",
        "管理者が差し戻し / 承認"
      ],
      "guards": [
        "ロール",
        "Record access",
        "承認条件"
      ],
      "cancel": "approvedは直接編集しない"
    }
  ],
  "integrations": [
    {
      "group": "AI",
      "name": "OpenAI Responses API",
      "purpose": "インタビュー・質問設計・構造化出力",
      "boundary": "Backend Agent / Provider層",
      "failure": "失敗時は状態を確定せず、別Providerへ切り替えない"
    },
    {
      "group": "Voice",
      "name": "OpenAI GPT Live",
      "purpose": "WebRTC音声対話と音声イベント",
      "boundary": "Browser WebRTC + Backend session API",
      "failure": "接続・評価失敗をユーザーへ返し、保存済み状態を維持する"
    },
    {
      "group": "Storage",
      "name": "PostgreSQL",
      "purpose": "構造化データと暗号化したアプリ設定を保存する",
      "boundary": "PostgresStore",
      "failure": "接続不能時はAPI起動または該当処理に失敗する"
    }
  ],
  "risks": [
    {
      "level": "HIGH",
      "topic": "OpenAI credential protection",
      "impact": "暗号化キーやAPIキーが漏れると外部APIを不正利用される",
      "evidence": "services/application_settings.py",
      "action": "暗号化キーをDB外で安全に管理し、ログやFrontendへ秘密情報を出さない"
    },
    {
      "level": "MEDIUM",
      "topic": "Worker is not connected",
      "impact": "非同期の文書取り込みは実行できない",
      "evidence": "app/worker/src/ai_interviewer_worker/main.py",
      "action": "要件確定後にWorker処理と永続化を実装する"
    },
    {
      "level": "MEDIUM",
      "topic": "Real GPT Live E2E",
      "impact": "ブラウザー・ネットワークごとの音声品質は通常の自動テストで確認できない",
      "evidence": "tests/e2e/voice/",
      "action": "APIキーと実ブラウザー環境で音声確認を行う"
    }
  ],
  "tests": [
    {
      "risk": "API state and authorization",
      "behavior": "記録アクセス、回答状態、テナント範囲",
      "existing": "app/api/tests/integration と unit tests",
      "gap": "実運用環境の認証・負荷"
    },
    {
      "risk": "PostgreSQL persistence",
      "behavior": "保存とテナントスコープ",
      "existing": "test_postgres_store.py（TEST_DATABASE_URL指定時）",
      "gap": "実運用負荷・接続プール"
    },
    {
      "risk": "OpenAI provider boundary",
      "behavior": "Structured OutputとAPIエラー境界",
      "existing": "app/api/tests/unit/agents と services",
      "gap": "実APIキーを使う接続確認"
    },
    {
      "risk": "Web UI",
      "behavior": "回答表示の状態分離、型・翻訳・Build",
      "existing": "Node test、TypeScript、i18n check",
      "gap": "主要画面のE2E"
    }
  ],
  "codeMap": [
    {
      "path": "app/web/src/app/App.tsx",
      "why": "Webアプリの組み立てとProviderの入口"
    },
    {
      "path": "app/api/src/ai_interviewer_api/main.py",
