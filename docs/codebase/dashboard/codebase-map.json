    },
    {
      "path": "app/api/src/ai_interviewer_api/services/application_settings.py",
      "why": "OpenAI Project APIキーの暗号化保存と取得"
    },
    {
      "path": "app/api/src/ai_interviewer_api/services/live_session.py",
      "why": "GPT Liveセッション作成"
    },
    {
      "path": "infra/docker-compose.yml",
      "why": "ローカルWeb、API、PostgreSQLの構成"
    }
  ],
