API_PORT=8001
WEB_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=kikiori
POSTGRES_USER=kikiori
POSTGRES_PASSWORD=kikiori
DATABASE_URL=postgresql://kikiori:kikiori@localhost:5432/kikiori

# Document text/chunk backend. PostgreSQL is the default; use
# elasticsearch with the Elastic Cloud settings below to switch the RAG index.
DOCUMENT_KNOWLEDGE_BACKEND=postgres
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_URL=
ELASTICSEARCH_DOCUMENT_INDEX=kikiori-documents-v1
ELASTICSEARCH_DOCUMENT_CHUNK_INDEX=kikiori-document-chunks-v1
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=10
DOCUMENT_CHUNK_SIZE_CHARS=1200
DOCUMENT_CHUNK_OVERLAP_CHARS=150

AWS_PROFILE=your-profile-name
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
VITE_VOICE_ICE_GATHERING_TIMEOUT_MS=1000
VITE_VOICE_SIGNALING_TIMEOUT_MS=8000
# Set to gpt_live to use the Phase 1 GPT-Live WebRTC path by default.
VOICE_RUNTIME_PROVIDER=transcribe_polly
BEDROCK_AWS_REGION=ap-northeast-1
STRUCTURED_INTERVIEW_MODEL_ID=global.openai.gpt-5.6-luna
STRUCTURED_INTERVIEW_FAST_PATH_ENABLED=false
STRUCTURED_INTERVIEW_FAST_MODEL_ID=global.openai.gpt-5.6-luna
STRUCTURED_INTERVIEW_FAST_REASONING_EFFORT=none
STRUCTURED_INTERVIEW_FAST_MAX_OUTPUT_TOKENS=160
STRUCTURED_INTERVIEW_REASONING_EFFORT=low
STRUCTURED_INTERVIEW_QUESTION_REASONING_EFFORT=none
STRUCTURED_INTERVIEW_MEDIUM_REASONING_EFFORT=medium
STRUCTURED_INTERVIEW_MAX_OUTPUT_TOKENS=6000
STRUCTURED_INTERVIEW_QUESTION_MAX_OUTPUT_TOKENS=600
QUESTION_DESIGN_MODEL_ID=global.openai.gpt-5.6-luna
QUESTION_DESIGN_REASONING_EFFORT=low
QUESTION_DESIGN_MAX_OUTPUT_TOKENS=6000
STRUCTURED_INTERVIEW_CONNECT_TIMEOUT_SECONDS=5
STRUCTURED_INTERVIEW_READ_TIMEOUT_SECONDS=120
VOICE_ENABLE_BACKCHANNELS=false
VOICE_WEBRTC_PLAYBACK_DRAIN_TIMEOUT_SECONDS=5

# GPT-Live and OpenAI Realtime share this server-side key. Never copy it into
# a VITE_* variable.
OPENAI_TRACKING_ID=
OPENAI_SECRET_KEY=
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=
# Realtime-2 accepts minimal/low/medium/high/xhigh; blank omits the field.
OPENAI_REALTIME_REASONING_EFFORT=
OPENAI_REALTIME_MAX_SESSION_MINUTES=30
OPENAI_REALTIME_TURN_DETECTION=semantic_vad
OPENAI_REALTIME_SEMANTIC_EAGERNESS=low
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_SIDEBAND_CONNECT_TIMEOUT_SECONDS=10
