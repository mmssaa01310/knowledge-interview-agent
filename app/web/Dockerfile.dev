FROM node:22-bookworm-slim

WORKDIR /workspace

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /workspace/
COPY app/web/package.json /workspace/app/web/package.json
COPY packages/shared-types/package.json /workspace/packages/shared-types/package.json

RUN corepack enable \
    && corepack prepare pnpm@11.11.0 --activate \
    && pnpm install --frozen-lockfile

CMD ["pnpm", "--dir", "app/web", "dev", "--host", "0.0.0.0"]
